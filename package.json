{
  "name": "imessage-query",
  "version": "0.2.0",
  "description": "Bun CLI for querying local iMessage messages on macOS",
  "keywords": [
    "bun",
    "cli",
    "imessage",
    "macos",
    "sqlite"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "bin": {
    "imessage-query": "bin/imessage-query"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berrydev-ai/imessage-query.git"
  },
  "homepage": "https://github.com/berrydev-ai/imessage-query",
  "bugs": {
    "url": "https://github.com/berrydev-ai/imessage-query/issues"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "dev": "bun --watch src/cli.ts",
    "doctor": "bun run src/cli.ts doctor",
    "ci": "bun run check && bun test && bun run pack:dry-run",
    "test": "bun test",
    "check": "tsc --noEmit",
    "pack:dry-run": "npm pack --dry-run",
    "pack": "rm -rf dist && mkdir -p dist && npm pack --pack-destination dist"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  }
}
